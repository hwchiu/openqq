{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Tenant Server Request Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum by (method, status) (rate(opensandbox_tenant_server_requests_total[5m]))", "legendFormat": "{{method}} {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Quota Rejections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum by (tenant) (rate(opensandbox_tenant_server_quota_rejections_total[5m]))", "legendFormat": "{{tenant}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Egress Operations by Tenant",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum by (tenant, method, result) (rate(opensandbox_tenant_server_egress_operations_total[5m]))", "legendFormat": "{{tenant}} {{method}} {{result}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Egress Failures (5m)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(increase(opensandbox_tenant_server_egress_operations_total{result=\"failed\"}[5m]))", "legendFormat": "failed"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "title": "Active Sandboxes by Tenant",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum by (tenant) (opensandbox_tenant_server_active_sandboxes)", "legendFormat": "{{tenant}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["opensandbox", "tenant-server", "egress"],
  "templating": {"list": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {}}]},
  "time": {"from": "now-6h", "to": "now"},
  "title": "OpenSandbox Tenant Server",
  "uid": "opensandbox-tenant-server",
  "version": 1
}
