OPENSANDBOX_SERVER_URL=http://opensandbox-server:8080
OPENSANDBOX_API_KEY=replace-me
OPENSANDBOX_EXECD_TOKEN=replace-with-execd-access-token
# Must resolve to the Execd HTTP endpoint for the created sandbox.
# Example shape only; fill it according to the installed ingress/proxy mode.
OPENSANDBOX_EXEC_BASE_URL_TEMPLATE=http://opensandbox-server/v1/sandboxes/{sandbox_id}/proxy/44772
OPENSANDBOX_IMAGE=replace-with-the-official-code-interpreter-image
MAX_CODE_BYTES=65536
MAX_FILE_BYTES=10485760
RUN_TIMEOUT_MS=60000
RUN_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173
